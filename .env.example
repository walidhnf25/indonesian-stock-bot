# Copy to .env and fill in. NEVER commit .env (it is git-ignored). Never paste real secrets into this file.

# --- Database (docker compose up -d; host port 5436 to avoid clashing with other local Postgres on 5432) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/ai_stock
# Used by docker-compose.yml only (it defaults to the values above). Change them together with DATABASE_URL.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=ai_stock
# POSTGRES_PORT=5436

# --- Telegram (create a bot with @BotFather) ---
# Leave empty to run without Telegram (REST API + CLI chat only).
# If a token was ever exposed (pasted in chat, a screenshot, a log, a commit): revoke it in @BotFather
# (/revoke) and put the NEW token only in your local .env.
TELEGRAM_BOT_TOKEN=

# Master switch for the Telegram transport. false = REST/CLI only even when a token is set.
# Tests ALWAYS run with Telegram off, whatever this says (see README "Testing").
TELEGRAM_ENABLED=true

# Who may use the bot.
#   allowlist (default, safest): only the IDs in TELEGRAM_ALLOWED_USER_IDS. FAIL CLOSED: when that list is
#            empty, EVERY Telegram user is rejected (a warning is logged at startup).
#   public:  EVERY Telegram user can use the bot and consume your CPU / local AI model. The list is ignored.
#            Per-user rate limits, per-user AI quotas and the bounded AI queue still apply. Must be set
#            explicitly: an empty list never means public.
TELEGRAM_ACCESS_MODE=allowlist
# Numeric Telegram user IDs, comma separated, e.g. 123456789,987654321 (find yours with @userinfobot).
# Invalid entries stop the app at startup with a clear error.
TELEGRAM_ALLOWED_USER_IDS=

# --- Stock data ---
# yahoo = Yahoo Finance (free, no key, unofficial, ~10 min delayed for IDX)
STOCK_DATA_PROVIDER=yahoo
STOCK_API_KEY=
# Comma separated extra IDX tickers for screening (added to the built-in list). Optional.
SCREENER_EXTRA_SYMBOLS=

# --- AI (ollama | gemini | openai) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Must be a model you have pulled, e.g. `ollama pull qwen3:4b-instruct`
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# AI cost / resource limits (all enforced in this process; none of them need Redis)
# Longest one analysis/answer generation may take (a CPU-only 4B model needs ~25-30 s typically).
AI_TIMEOUT_MS=90000
# Largest model response accepted (a chat answer is a few KB); the read is cancelled the moment it is exceeded.
AI_MAX_RESPONSE_BYTES=1048576
# Short budget for AI intent classification, which is only a fallback for unrecognised messages.
AI_INTENT_TIMEOUT_MS=10000
# Simultaneous generations. Keep 1 for a local CPU model.
AI_MAX_CONCURRENT_REQUESTS=1
# Requests allowed to wait for a free slot; more than this get a "busy" reply with the technical data.
AI_MAX_QUEUE_DEPTH=3
# Fairness between users (public bot): one user may run this many generations at once and have this
# many waiting. More from the same user are answered "busy" immediately; other users keep their turn.
AI_MAX_CONCURRENT_PER_USER=1
AI_MAX_QUEUE_PER_USER=1
# Only the first N characters of a question are sent to the model.
AI_QUESTION_MAX_CHARS=300
AI_QUEUE_WAIT_TIMEOUT_MS=60000
# Per user, per minute
AI_ANALYSIS_MAX_REQUESTS_PER_USER_PER_MINUTE=5
AI_INTENT_MAX_REQUESTS_PER_USER_PER_MINUTE=10

# --- App ---
# All switches (TELEGRAM_ENABLED, ALERT_CHECK_WHEN_CLOSED, REST_ALLOW_REMOTE) accept true/false, 1/0,
# yes/no, on/off. Anything else stops startup (it is never silently treated as a default).
# Numbers have sane upper bounds too (e.g. ALERT_CHECK_INTERVAL_SECONDS 10..3600, PORT 1..65535).
PORT=3000
# The REST API has NO authentication, so it must stay on a loopback address (127.0.0.1, localhost, ::1).
# Any other HOST stops startup unless REST_ALLOW_REMOTE=true, which you should only set behind a firewall
# or an authenticating reverse proxy. Requests with a non-loopback Host/Origin header are refused (403).
HOST=127.0.0.1
REST_ALLOW_REMOTE=false

# --- Redis (optional): shared quotas/locks/queues across processes. Empty = everything runs in-process. ---
# docker compose exposes Redis on 127.0.0.1:6380 (6379 is often taken by other local projects).
# Redis holds quotas and queued notifications: whoever can write to it can enqueue jobs. A Redis on another host MUST
# carry a password in the URL (redis://:password@host:6379/0); startup is refused otherwise. For docker compose set
# REDIS_PASSWORD (compose side) and use the same value in REDIS_URL. Loopback Redis may stay without a password.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=2000
# Opt-out of the rule above ONLY when the network path to Redis is private and trusted.
REDIS_ALLOW_UNAUTHENTICATED=false
# docker compose only (not read by the application): makes the compose Redis require this password.
REDIS_PASSWORD=
REDIS_KEY_PREFIX=stockbot:
# Process role: all (default) | gateway (Telegram + REST, no queue workers; needs REDIS_URL) | worker (queue workers + local REST, no Telegram).
BOT_ROLE=all
LOG_LEVEL=info
NODE_ENV=development
TZ=Asia/Jakarta

# --- Alerts / market ---
ALERT_CHECK_INTERVAL_SECONDS=120
# Check alerts even when the market is closed (default false)
ALERT_CHECK_WHEN_CLOSED=false
# Days after creation after which an untriggered alert expires (the owner is told once).
ALERT_TTL_DAYS=90
# Minutes the per-chat conversation context (last tickers and lookups, never message text) is kept.
CONTEXT_TTL_MINUTES=30

# --- Knowledge base / RAG (docs/rag.md) ---
# Retrieval over the built-in knowledge corpus and personal notes; needs the pgvector extension (docker/postgres).
RAG_ENABLED=true
# hashing = deterministic, no model needed (default); ollama = /api/embed with EMBEDDING_MODEL
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=20000
# Largest embedding response accepted (a batch of vectors).
EMBEDDING_MAX_RESPONSE_BYTES=8388608
# Percent: a hit found only by the vector channel must be at least this similar to count
RAG_MIN_SIMILARITY=30

# --- Fundamentals (docs/fundamentals.md) ---
# Figures served from a stored snapshot older than this many days are marked "basi" (stale)
FUNDAMENTALS_STALE_DAYS=7
FUNDAMENTAL_SNAPSHOT_RETENTION_DAYS=400

# --- News (docs/news.md) ---
# yahoo (headlines from the Yahoo search endpoint) or none
NEWS_PROVIDER=yahoo
NEWS_MAX_AGE_DAYS=14
NEWS_CACHE_TTL_SECONDS=900
NEWS_RETENTION_DAYS=90
# Comma separated YYYY-MM-DD exchange holidays (IDX holidays change yearly)
MARKET_HOLIDAYS=

# --- Data quality ---
# During trading hours a quote older than this (plus the provider's declared delay) is labelled STALE.
# Outside trading hours the rule is "not older than the last trading session", not this number.
MARKET_DATA_STALE_AFTER_MINUTES=30
# A move bigger than this (percent) vs the previous close makes the quote SUSPECT: the user is warned
# and alerts are skipped, even if open/high/low agree with it (a corrupt quote can agree with itself).
# Real ARA/ARB days (about +/-35 %) stay trusted. There is no fixed price floor.
PRICE_ANOMALY_MAX_CHANGE_PERCENT=50
# A quote's previous close may differ from the stored daily close by at most this much (percent)
# before the quote is SUSPECT. Suspect and invalid quotes never trigger alerts.
PRICE_REFERENCE_TOLERANCE_PERCENT=5

# --- Rate limits / cache ---
USER_RATE_LIMIT_PER_MINUTE=20
# Longest message Indonesian Stock Bot will process (characters). Longer text is refused before any parsing or AI work.
MAX_INPUT_LENGTH=1000
# Max tickers per message. More than this is refused with an explicit message, never truncated.
MAX_SYMBOLS_PER_REQUEST=5
QUOTE_CACHE_TTL_SECONDS=60
HISTORY_CACHE_TTL_SECONDS=900
STOCK_API_MAX_CONCURRENCY=3
STOCK_API_MIN_INTERVAL_MS=150

# --- Market-data governance: who may cause how many calls to the data provider (Yahoo) ---
# Every call that is NOT served from cache is charged to the person who caused it. Refused calls never reach
# the provider; the user gets stored data (marked stale) or a short message. See docs/market-data.md.
# Uncached provider calls one user may cause per minute (each retry attempt counts).
MARKET_DATA_USER_UNCACHED_PER_MINUTE=30
# Portfolio bookkeeping limits (per user): distinct stocks held, ledger rows per rolling 24 h.
PORTFOLIO_MAX_HOLDINGS=50
PORTFOLIO_MAX_TRANSACTIONS_PER_DAY=100
# After this many ms, provider calls still queued or running for one chat request are cancelled.
CHAT_REQUEST_DEADLINE_MS=240000
# Uncached provider calls one user may cause per HOUR. Together with the per-minute limit this bounds what a handful
# of accounts can drain: with the defaults it takes 27+ accounts to exhaust the user pool (it took 6 before).
MARKET_DATA_USER_UNCACHED_PER_HOUR=300
# Provider calls per hour in TOTAL (users + background jobs): the hard ceiling for the provider.
MARKET_DATA_GLOBAL_PER_HOUR=10000
# The part of that ceiling reserved for SYSTEM jobs (alert evaluation); users can never spend it, so ordinary accounts
# cannot silence alerts. users get GLOBAL - RESERVE = 8000/h. Sizing: one alert cycle costs 1 batch quote +
# 1 history per distinct alerted symbol (cached 15 min, so <= 4/h each): demand = 30 cycles/h + 4 x symbols, i.e. the
# default covers ~490 distinct symbols at a 120 s interval. Must be smaller than the ceiling; 0 = no reserve.
MARKET_DATA_SYSTEM_RESERVE_PER_HOUR=2000
# Calls that may wait for a slot (per user / in total); more are refused at once. Max wait and max run time:
MARKET_DATA_QUEUE_PER_USER=5
MARKET_DATA_QUEUE_GLOBAL=200
# Extra waiting slots only system jobs may take (users cannot fill them), and the system jobs are served first.
MARKET_DATA_QUEUE_SYSTEM=100
MARKET_DATA_QUEUE_WAIT_MS=15000
MARKET_DATA_TIMEOUT_MS=20000
# Largest HTTP response accepted from the market-data/news provider; the read is cancelled the moment it is exceeded.
MARKET_DATA_MAX_RESPONSE_BYTES=4194304
# Consecutive provider failures that stop all calls for a while (circuit breaker), and for how long.
MARKET_DATA_BREAKER_FAILURES=5
MARKET_DATA_BREAKER_COOLDOWN_SECONDS=30
# How long "this ticker exists" / "no such ticker" is remembered.
TICKER_EXISTS_TTL_SECONDS=86400
TICKER_MISSING_TTL_SECONDS=120

# --- Data retention (days). Rows STRICTLY older than this are deleted; active alerts never are. ---
FETCH_LOG_RETENTION_DAYS=7
AI_ANALYSIS_RETENTION_DAYS=30
ALERT_HISTORY_RETENTION_DAYS=30
# How often the retention job runs (hours)
RETENTION_INTERVAL_HOURS=6
